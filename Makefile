# saetta: C engine with Metal kernels. `make` builds $(BUILD)/bin/saetta, which runs
# Qwen3.8-Flash-Next and Qwen3.8-27B (each model's code compiled against its own constants,
# src/config_flash.h and src/config_27b.h; src/model_api.c picks one by the pack).
CC      := clang
BUILD   ?= build
GOLDEN  ?= tests/golden
# the 27B goldens next to GOLDEN (each names its pack in manifest.json); absent ones are skipped
GOLDENS_27B := golden-27b-4bit golden-27b-8bit golden-27b-4bit-pi golden-27b-4bit-partial golden-27b-turbo
# the Coder variant's golden (its manifest names the pack without a folder); skipped when absent
MODELS ?= $(or $(SAETTA_MODELS),$(HOME)/Models)
CODER_PACK ?= $(MODELS)/mbrown-uno/Qwen3.8-Flash-Next-GSQ-RCO-Coder-MLX
# Inkling 2 Mini's goldens beside GOLDEN (1815 tokens; 8329, past the log-scaling floor), on
# INKLING_PACK; skipped when either is absent
GOLDENS_INKLING := golden-inkling golden-inkling-long
INKLING_PACK ?= $(MODELS)/mlx-community/Inkling-2-Mini-4bit

# MCPU: the oldest CPU the binary runs on (every Apple Silicon Mac); -mcpu=native would let
# the compiler use the build machine's newer instructions
MCPU    ?= apple-m1
CFLAGS  := -std=c23 -O3 -ffp-contract=off -mcpu=$(MCPU) -mmacosx-version-min=26.0 \
           -Wall -Wextra -Wno-unused-parameter
OBJCFLAGS := -fobjc-arc -O2 -mcpu=$(MCPU) -mmacosx-version-min=26.0 -Wall -Wextra -Wno-unused-parameter
DEPFLAGS = -MMD -MP
LDFLAGS := -mmacosx-version-min=26.0
LDLIBS  := -framework Metal -framework Foundation -framework Accelerate -lpthread

OBJ  := $(BUILD)/obj
BIN  := $(BUILD)/bin/saetta
SRCS := $(wildcard src/*.c)
OBJS := $(SRCS:src/%.c=$(OBJ)/%.o) $(OBJ)/metal/shim.o
TEST_SRCS := $(wildcard src/test/*.c)
TEST_OBJS := $(TEST_SRCS:src/test/%.c=$(OBJ)/test/%.o)
LIB_OBJS  := $(filter-out $(OBJ)/main.o,$(OBJS))

.PHONY: all test verify verify-quick verify-dsv4 bench clean FORCE
.DELETE_ON_ERROR:

all: $(BIN)

$(BIN): $(OBJS)
	@mkdir -p $(@D)
	$(CC) $(LDFLAGS) -o $@ $^ $(LDLIBS)

$(BUILD)/bin/saetta-test: $(LIB_OBJS) $(TEST_OBJS)
	@mkdir -p $(@D)
	$(CC) $(LDFLAGS) -o $@ $^ $(LDLIBS)

# The engine build's identity, for the conversation state on disk (src/state_store.h): a hash of
# the engine's sources (src/ but Saetta Code's own files and the tests, the kernels, the shim)
# and of the compiler (its --version) and its flags, so a saved state is only read by the build that wrote it.
# Rewritten only when it changes (server.o then rebuilds).
ENGINE_ID_SRCS = $(sort $(filter-out src/code_%,$(wildcard src/*.c src/*.h)) $(wildcard src/kernels/*.metal src/metal/*))
$(OBJ)/engine_id.h: FORCE
	@mkdir -p $(@D)
	@s=$$(cat $(ENGINE_ID_SRCS) | shasum -a 256 | cut -c1-16); f=$$( (echo '$(CC) $(CFLAGS) $(OBJCFLAGS)'; $(CC) --version) | shasum -a 256 | cut -c1-8); \
	  printf '// generated by the Makefile: the engine build identity\n#define SAETTA_ENGINE_ID "%s-%s"\n' $$s $$f > $@.tmp; \
	  cmp -s $@.tmp $@ || mv $@.tmp $@; rm -f $@.tmp
$(OBJ)/server.o: $(OBJ)/engine_id.h

# #embed'ed kernels (src/kernels/*.metal) are recorded in the .d files by -MMD.
$(OBJ)/%.o: src/%.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -I$(OBJ) $(DEPFLAGS) -c $< -o $@

$(OBJ)/metal/shim.o: src/metal/shim.m
	@mkdir -p $(@D)
	$(CC) $(OBJCFLAGS) $(DEPFLAGS) -c $< -o $@

# Runs every test, or those whose name contains T (make test T=json). SAETTA_PACK passes
# through the environment.
test: $(BUILD)/bin/saetta-test
	$(BUILD)/bin/saetta-test $(T)

# Flash-Next against GOLDEN, the Coder variant against golden-coder, Qwen3.8-27B against the
# goldens beside it that exist, then Inkling 2 Mini
verify: $(BIN)
	$(BIN) verify $(GOLDEN)
	@d="$(dir $(abspath $(GOLDEN)))golden-coder"; \
	  if [ -d "$$d" ] && [ -d "$(CODER_PACK)" ]; then echo "verify: $$d"; SAETTA_PACK="$(CODER_PACK)" $(BIN) verify "$$d" || exit 1; \
	  elif [ -d "$$d" ]; then echo "verify: no Coder pack at $(CODER_PACK), golden-coder skipped"; fi
	@for g in $(GOLDENS_27B); do d="$(dir $(abspath $(GOLDEN)))$$g"; \
	  if [ -d "$$d" ]; then echo "verify: $$d"; env -u SAETTA_PACK $(BIN) verify "$$d" || exit 1; fi; done
	@for g in $(GOLDENS_INKLING); do d="$(dir $(abspath $(GOLDEN)))$$g"; \
	  if [ -d "$$d" ] && [ -d "$(INKLING_PACK)" ]; then echo "verify: $$d"; SAETTA_PACK="$(INKLING_PACK)" $(BIN) verify "$$d" || exit 1; \
	  elif [ -d "$$d" ]; then echo "verify: no Inkling pack at $(INKLING_PACK), $$g skipped"; fi; done

# The commit hook's check: one golden per model family in QUICK (flash, 27b, inkling; default
# all three), the fastest of each: the Coder (or GOLDEN, the full Flash-Next, without the Coder
# pack), golden-27b-4bit, golden-inkling. `make verify` (every golden) runs before each release.
QUICK ?= flash 27b inkling
verify-quick: $(BIN)
	@b="$(dir $(abspath $(GOLDEN)))"; for f in $(QUICK); do \
	  case $$f in \
	    flash) if [ -d "$(CODER_PACK)" ] && [ -d "$${b}golden-coder" ]; then d="$${b}golden-coder"; p="$(CODER_PACK)"; else d="$(abspath $(GOLDEN))"; p=; fi;; \
	    27b) d="$${b}golden-27b-4bit"; p=;; \
	    inkling) d="$${b}golden-inkling"; p="$(INKLING_PACK)";; \
	    *) echo "verify-quick: unknown family $$f"; exit 1;; \
	  esac; \
	  if [ ! -d "$$d" ] || { [ -n "$$p" ] && [ ! -d "$$p" ]; }; then echo "verify-quick: $$f skipped (no golden or pack)"; continue; fi; \
	  echo "verify-quick: $$d"; \
	  if [ -n "$$p" ]; then SAETTA_PACK="$$p" $(BIN) verify "$$d" || exit 1; else env -u SAETTA_PACK $(BIN) verify "$$d" || exit 1; fi; \
	done

# DeepSeek-V4-Flash against its goldens next to GOLDEN: the forced per-layer check on the
# all-positions golden, then the functional check on the others (streamed experts, cache
# SAETTA_EXPERT_CACHE_GB, default 40). Skipped when the pack is absent. Not part of verify.
DSV4_PACK ?= $(HOME)/Models/deepseek-ai/DeepSeek-V4-Flash-0731
GOLDENS_DSV4 := golden-dsv4-short-decode-all golden-dsv4-short-decode golden-dsv4-long
verify-dsv4: $(BIN)
	@if [ ! -d "$(DSV4_PACK)" ]; then echo "verify-dsv4: no DeepSeek-V4-Flash pack at $(DSV4_PACK), skipped"; exit 0; fi; \
	for g in $(GOLDENS_DSV4); do d="$(dir $(abspath $(GOLDEN)))$$g"; \
	  if [ -d "$$d" ]; then echo "verify: $$d"; \
	    SAETTA_PACK="$(DSV4_PACK)" SAETTA_EXPERT_CACHE_GB=$${SAETTA_EXPERT_CACHE_GB:-40} $(BIN) verify "$$d" || exit 1; \
	  else echo "verify-dsv4: $$d absent, skipped"; fi; done

bench: $(BIN)
	$(BIN) qgen-bench

clean:
	rm -rf $(BUILD)

-include $(OBJS:.o=.d) $(TEST_OBJS:.o=.d)
